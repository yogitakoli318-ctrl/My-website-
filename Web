<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>AstraIntel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/marked/9.1.6/marked.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: { 
                        darkBg: '#000000', 
                        liteBg: '#f1f5f9',
                        darkCard: 'rgba(15, 15, 15, 0.8)', 
                        liteCard: 'rgba(255, 255, 255, 0.8)',
                        accent: '#ffffff' 
                    },
                    fontFamily: { sans: ['Plus Jakarta Sans', 'sans-serif'] }
                }
            }
        }
    </script>
    <style>
        /* JARVIS DYNAMIC GRID BACKGROUND */
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            overflow: hidden; 
            transition: background-color 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            background-size: 30px 30px;
            background-attachment: fixed;
        }

        /* Dark Mode Grid */
        .dark body { 
            background-color: #000000;
            background-image: radial-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px);
        }
        
        /* Lite Mode Grid */
        body:not(.dark) { 
            background-color: #f1f5f9;
            background-image: radial-gradient(rgba(0, 0, 0, 0.08) 1px, transparent 1px);
        }

        .glass { backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
        .drawer-transition { transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        
        .message-appear { animation: slideUp 0.3s ease-out forwards; }
        @keyframes slideUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        .pill-input-container { 
            bottom: env(safe-area-inset-bottom, 24px); 
            left: 50%; 
            transform: translateX(-50%); 
            width: calc(100% - 24px); 
            max-width: 600px; 
            z-index: 50; 
        }

        .prose-content ul { list-style-type: disc; padding-left: 1.25rem; margin-bottom: 0.5rem; }
        .prose-content strong { color: inherit; font-weight: 800; }
        .dark .prose-content strong { color: #ffffff; text-shadow: 0 0 8px rgba(255,255,255,0.3); }

        @keyframes mic-pulse { 0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); } 70% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); } 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); } }
        .mic-active { animation: mic-pulse 1.5s infinite; background-color: #ef4444 !important; color: white !important; }

        .pulse-dot { width: 6px; height: 6px; border-radius: 50%; animation: pulse 1.4s infinite ease-in-out both; }
        .dark .pulse-dot { background: #ffffff; }
        body:not(.dark) .pulse-dot { background: #000000; }
        
        @keyframes pulse { 0%, 80%, 100% { transform: scale(0); } 40% { transform: scale(1.0); } }
        
        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-thumb { background: rgba(128,128,128,0.2); border-radius: 10px; }
    </style>
</head>
<body class="text-slate-900 dark:text-slate-100">

    <!-- Header -->
    <header class="fixed top-0 w-full z-40 glass border-b border-slate-200 dark:border-neutral-900 bg-white/60 dark:bg-black/60 px-4 py-3 flex items-center justify-between transition-colors">
        <div class="flex items-center gap-2">
            <div class="bg-black dark:bg-white p-1.5 rounded-lg shadow-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white dark:text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            </div>
            <h1 class="font-bold text-lg tracking-tighter uppercase tracking-[0.1em]">AstraIntel</h1>
        </div>
        <div class="flex items-center gap-3">
            <button id="themeToggle" class="p-2 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors">
                <svg id="sunIcon" class="h-5 w-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.364l-.707-.707M15 12a3 3 0 11-6 0 3 3 0 016 0z" stroke-width="2"/></svg>
                <svg id="moonIcon" class="h-5 w-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" stroke-width="2"/></svg>
            </button>
            <button id="menuBtn" class="flex flex-col gap-1.5 p-2 bg-black/5 dark:bg-white/10 rounded-lg">
                <div class="w-6 h-0.5 bg-black dark:bg-white"></div>
                <div class="w-6 h-0.5 bg-black dark:bg-white opacity-50"></div>
            </button>
        </div>
    </header>

    <!-- Chat Area -->
    <main id="chatArea" class="h-screen overflow-y-auto pt-24 pb-44 px-4 space-y-6"></main>

    <!-- Optimized Action Bar -->
    <div class="fixed pill-input-container">
        <div class="relative flex items-center bg-white/90 dark:bg-black/80 glass border-2 border-slate-300 dark:border-neutral-800 rounded-2xl shadow-2xl p-2 gap-1 transition-all">
            <input type="text" id="userInput" placeholder="System Awaiting Input..." class="flex-1 bg-transparent border-none outline-none px-4 text-sm text-slate-900 dark:text-white placeholder:text-slate-400 font-medium" autocomplete="off">
            
            <div class="flex items-center gap-1 bg-slate-100 dark:bg-white/5 p-1 rounded-xl">
                <button id="micBtn" class="text-slate-500 dark:text-slate-400 hover:text-red-500 p-3 rounded-lg transition-all active:scale-90">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" /></svg>
                </button>
                <button id="sendBtn" class="bg-black dark:bg-white text-white dark:text-black p-3 rounded-lg transition-all hover:brightness-110 active:scale-90 shadow-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transform rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Study Hub Drawer -->
    <div id="drawerOverlay" class="fixed inset-0 bg-black/60 opacity-0 pointer-events-none transition-opacity z-[60]"></div>
    <div id="sideDrawer" class="fixed top-0 right-0 h-full w-[85%] max-w-sm bg-white/95 dark:bg-black/90 glass border-l border-slate-200 dark:border-neutral-900 z-[70] transform translate-x-full shadow-2xl overflow-y-auto drawer-transition">
        <div class="p-6">
            <h2 class="text-xl font-black tracking-widest mb-8 uppercase italic opacity-40 text-center">System Hub</h2>
            <div class="grid grid-cols-1 gap-3">
                <button id="newChatBtn" class="flex items-center gap-4 p-5 rounded-xl bg-black dark:bg-white text-white dark:text-black font-black uppercase text-xs tracking-[0.2em] shadow-lg mb-4">
                    <span>+</span> New Session
                </button>
                <button onclick="toggleModal('historyModal'); renderHistory();" class="flex items-center gap-4 p-4 rounded-xl bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 font-bold hover:bg-white/10 transition-all">
                    <span>🔍</span> History
                </button>
                <button onclick="toggleModal('libraryModal')" class="flex items-center gap-4 p-4 rounded-xl bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 font-bold hover:bg-white/10 transition-all">
                    <span>📚</span> Library
                </button>
                <button onclick="toggleModal('notebookModal')" class="flex items-center gap-4 p-4 rounded-xl bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 font-bold hover:bg-white/10 transition-all">
                    <span>📔</span> Notebook
                </button>
                <button onclick="toggleModal('settingsModal')" class="flex items-center gap-4 p-4 rounded-xl bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 font-bold hover:bg-white/10 transition-all">
                    <span>⚙️</span> Access Key
                </button>
            </div>
        </div>
    </div>

    <!-- Modals -->
    <div id="historyModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-black/80" onclick="toggleModal('historyModal')"></div>
        <div class="relative bg-white dark:bg-black/80 glass w-full max-w-lg rounded-3xl h-[80vh] flex flex-col border border-slate-200 dark:border-white/10 overflow-hidden shadow-2xl">
            <div class="p-5 border-b border-slate-200 dark:border-white/10">
                <input type="text" id="historySearch" placeholder="Search sessions..." class="w-full bg-slate-100 dark:bg-white/5 p-4 rounded-xl text-sm outline-none border border-slate-200 dark:border-white/5">
            </div>
            <div id="historyList" class="flex-1 overflow-y-auto p-4 space-y-3"></div>
        </div>
    </div>

    <div id="settingsModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-black/80" onclick="toggleModal('settingsModal')"></div>
        <div class="relative bg-white dark:bg-black/80 glass w-full max-w-md rounded-3xl p-8 border border-slate-200 dark:border-white/10 shadow-2xl">
            <h3 class="font-black uppercase text-[10px] tracking-widest mb-4 opacity-40">Authentication</h3>
            <input type="password" id="apiKeyInput" placeholder="Gemini API Key..." class="w-full bg-slate-100 dark:bg-white/5 border-2 border-slate-200 dark:border-white/5 rounded-xl p-4 text-sm mb-6 outline-none">
            <button id="saveSettings" class="w-full bg-black dark:bg-white text-white dark:text-black font-black py-4 rounded-xl uppercase text-xs tracking-[0.3em] shadow-lg">Synchronize</button>
        </div>
    </div>

    <script>
        const state = {
            apiKey: localStorage.getItem('astraintel_key') || '',
            notebook: localStorage.getItem('astraintel_notes') || '',
            history: JSON.parse(localStorage.getItem('astraintel_history') || '[]'),
            model: 'https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent'
        };

        const chatArea = document.getElementById('chatArea');
        const userInput = document.getElementById('userInput');

        // Speech Recognition
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        let recognition;
        if (SpeechRecognition) {
            recognition = new SpeechRecognition();
            recognition.onstart = () => document.getElementById('micBtn').classList.add('mic-active');
            recognition.onresult = (e) => { userInput.value = e.results[0][0].transcript; sendMessage(); };
            recognition.onend = () => document.getElementById('micBtn').classList.remove('mic-active');
        }

        async function sendMessage() {
            const text = userInput.value.trim();
            if (!text || !state.apiKey) return;
            appendMessage('user', text);
            userInput.value = '';
            const loadingId = appendLoading();
            try {
                const response = await fetch(state.model, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'x-goog-api-key': state.apiKey.replace(/\s/g, '') },
                    body: JSON.stringify({ contents: [{ parts: [{ text: `Act as AstraIntel Student Tutor. Use structured bullet points. Question: ${text}` }] }] })
                });
                const data = await response.json();
                const aiText = data.candidates[0].content.parts[0].text;
                removeLoading(loadingId);
                appendMessage('ai', aiText);
                state.history.unshift({ timestamp: new Date().toLocaleString(), prompt: text, response: aiText });
                localStorage.setItem('astraintel_history', JSON.stringify(state.history.slice(0, 50)));
            } catch (e) { removeLoading(loadingId); }
        }

        function appendMessage(role, text) {
            const div = document.createElement('div');
            div.className = `flex flex-col gap-2 ${role === 'user' ? 'items-end' : 'items-start'} message-appear`;
            const innerClass = role === 'user' 
                ? 'bg-black dark:bg-white text-white dark:text-black font-bold shadow-xl border border-white/10' 
                : 'bg-white/60 dark:bg-black/40 glass border border-slate-200 dark:border-white/10 shadow-lg text-slate-800 dark:text-slate-100';
            div.innerHTML = `<div class="${innerClass} p-4 rounded-2xl text-sm max-w-[90%] prose-content">${marked.parse(text)}</div>`;
            chatArea.appendChild(div);
            chatArea.scrollTo({ top: chatArea.scrollHeight, behavior: 'smooth' });
        }

        function appendLoading() {
            const id = 'l-' + Date.now();
            const div = document.createElement('div');
            div.id = id; div.className = "flex flex-col items-start message-appear";
            div.innerHTML = `<div class="bg-white/40 dark:bg-white/5 glass p-4 rounded-2xl border border-slate-200 dark:border-white/10"><div class="flex gap-1"><div class="pulse-dot"></div><div class="pulse-dot"></div><div class="pulse-dot"></div></div></div>`;
            chatArea.appendChild(div);
            return id;
        }

        function removeLoading(id) { document.getElementById(id)?.remove(); }
        function toggleModal(id) { document.getElementById(id).classList.toggle('hidden'); }
        
        document.getElementById('menuBtn').addEventListener('click', () => { 
            document.getElementById('sideDrawer').style.transform = 'translateX(0)'; 
            document.getElementById('drawerOverlay').classList.replace('opacity-0', 'opacity-100'); 
            document.getElementById('drawerOverlay').classList.remove('pointer-events-none'); 
        });
        document.getElementById('drawerOverlay').addEventListener('click', () => { 
            document.getElementById('sideDrawer').style.transform = 'translateX(100%)'; 
            document.getElementById('drawerOverlay').classList.replace('opacity-100', 'opacity-0'); 
            document.getElementById('drawerOverlay').classList.add('pointer-events-none'); 
        });

        document.getElementById('sendBtn').addEventListener('click', sendMessage);
        userInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') sendMessage(); });
        document.getElementById('micBtn').addEventListener('click', () => recognition?.start());
        document.getElementById('saveSettings').addEventListener('click', () => { 
            state.apiKey = document.getElementById('apiKeyInput').value.trim(); 
            localStorage.setItem('astraintel_key', state.apiKey); 
            toggleModal('settingsModal'); 
        });
        document.getElementById('themeToggle').addEventListener('click', () => document.documentElement.classList.toggle('dark'));
        
        (function init() {
            document.getElementById('apiKeyInput').value = state.apiKey;
            appendMessage('ai', "System ready. Welcome to **AstraIntel** Lite/Dark interface.");
        })();
    </script>
</body>
</html>
